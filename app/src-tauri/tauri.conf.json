{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sonar",
  "identifier": "io.github.mtch3n.sonar",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Sonar",
        "width": 720,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "mtch3n",
    "copyright": "Copyright © 2026 mtch3n",
    "license": "MIT",
    "homepage": "https://github.com/mtch3n/sonar",
    "category": "Utility",
    "shortDescription": "Find any file on your computer",
    "longDescription": "Sonar indexes your home folder and finds files as you type, with filters for kind, extension, folder, date and size. It lives in the tray and opens with a keyboard shortcut.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "depends": [
          "libayatana-appindicator-gtk3"
        ]
      }
    }
  }
}
